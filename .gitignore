# =============================================================================
# HACKATHON SUBMISSION — .gitignore
# =============================================================================
# IMPORTANT: Never commit secrets, credentials, or large binary files.

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
dist/
.next/
.nuxt/
.output/
.cache/

# ── Java / Maven / Gradle ────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
.gradle/
build/

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/
*.exe

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
Cargo.lock  # remove this line if you want to commit lock file (recommended for apps)

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Large Media Files (use demo-video-link.txt instead) ───────────────────────
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv

# ── Docker volumes / local data ───────────────────────────────────────────────
# Ignore ad-hoc dumps under data/, but keep the committed synthetic dataset.
data/*
!data/.gitkeep
!data/assets.csv
!data/README.md
logs/
*.log
models/*.joblib

# ── Jupyter Notebooks (optional: remove if you want to commit notebooks) ──────
# .ipynb_checkpoints/

# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup

# ── Temporary validation / diagnostic scripts (generated during development) ──
validate_all.py
validate_all.bat
run_validate.bat
validate_output.txt
run_tests_now.bat
test_output.txt
check_dash_syntax.py
check_dash_syntax.bat
run_dash_check.bat
dash_syntax_out.txt
run_final_tests.bat
final_test_output.txt
run_validate.bat

# -- MCP inspection / one-off diagnostic outputs ----------------------------------------
inspect_mcp.py
inspect_mcp_out.txt
inspect_mcpserver_api.py
inspect_mcpserver_out.txt
run_inspect.bat
run_inspect2.bat
run_server_test.bat
server_start_out.txt
